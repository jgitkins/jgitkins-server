### Variable 
@url = localhost:8084



#######################################################
### Organize ##########################################
#######################################################

### 조직 생성
POST {{url}}/api/organizes

{
  "name": "BBB",
  "ownerId": 1,
  "description": "demo organize"
}

### 조직 목록 조회
GET {{url}}/api/organizes

### 조직 상세 조회
GET {{url}}/api/organizes/1

### 조직 수정
PUT {{url}}/api/organizes/1

{
  "name": "demo-org",
  "description": "updated"
}

### 조직 삭제
# DELETE {{url}}/api/organizes/4

#######################################################
### Repository ########################################
#######################################################

### 저장소 등록 within init commit
POST {{url}}/api/repositories

{
    "repoName": "aaa",
    "mainBranch": "main",
    "username": "heykia3",
    "email": "heykia3@protonmail.com",
    "organizeId": 1,
    "visibility": "PUBLIC",
    "readme": true,
    "message": "Initial Commit"
}

### 저장소 등록 without init commit
POST {{url}}/api/repositories

{
   "repoName": "bbb",
    "mainBranch": "main",
    "username": "heykia3",
    "email": "heykia3@protonmail.com",
    "organizeId": 2,
    "visibility": "PUBLIC"
}

### 저장소목록 조회
GET {{url}}/api/repositories

### 저장소 상세 조회
GET {{url}}/api/repositories/9

### 저장소 삭제
DELETE {{url}}/api/repositories/9

#######################################################
### Branch ############################################
#######################################################

### 브랜치 목록 조회
GET {{url}}/api/repositories/11/branches

### 브랜치 상세 조회
GET {{url}}/api/repositories/11/branches/main

### 브랜치 등록
GET {{url}}/api/repositories/11/branches

{
    "branchName": "develop",
    "sourceBranch": "main"
}

### 브랜치 삭제





#######################################################
### OAuth #############################################
#######################################################

### OAuth2 로그인 시작 (브라우저 리다이렉트 확인용)
GET {{url}}/oauth2/authorization/{{oauth_provider}}

#######################################################
### PAT ###############################################
#######################################################

### PAT 발급 (OAuth app_token 필요)
POST {{url}}/api/auth/pats
Authorization: Bearer {{app_token}}

### PAT 목록 조회
GET {{url}}/api/auth/pats
Authorization: Bearer {{app_token}}

### PAT 회수
DELETE {{url}}/api/auth/pats/1
Authorization: Bearer {{app_token}}

#######################################################
### Admin Users #######################################
#######################################################

### 사용자 목록
GET {{url}}/api/admin/users
Authorization: Bearer {{app_token}}

### 사용자 상세
GET {{url}}/api/admin/users/1
Authorization: Bearer {{app_token}}

### 사용자 상태 변경
PATCH {{url}}/api/admin/users/1/status
Authorization: Bearer {{app_token}}
Content-Type: application/json

{
  "status": "BLOCKED"
}

#######################################################
### Organize ##########################################
#######################################################

### 조직 생성
POST {{url}}/api/organizes
Authorization: Bearer {{app_token}}

{
  "name": "AAA",
  "ownerId": 1,
  "description": "demo organize"
}

### 조직 목록 조회
GET {{url}}/api/organizes
Authorization: Bearer {{app_token}}

### 조직 상세 조회
GET {{url}}/api/organizes/1
Authorization: Bearer {{app_token}}

### 조직 수정
PUT {{url}}/api/organizes/1
Authorization: Bearer {{app_token}}

{
  "name": "demo-org",
  "description": "updated"
}

### 조직 삭제
# DELETE {{url}}/api/organizes/4
Authorization: Bearer {{app_token}}

#######################################################
### Repository ########################################
#######################################################

### 저장소 등록 조직 within init commit
POST {{url}}/api/repositories
Authorization: Bearer {{app_token}}

{
    "repoName": "aaa2",
    "mainBranch": "main",
    "username": "heykia3",
    "email": "heykia3@protonmail.com",
    "organizeId": 1,
    "visibility": "PUBLIC",
    "readme": true,
    "message": "Initial Commit"
}

### 저장소 등록 개인 within init commit
POST {{url}}/api/repositories
Authorization: Bearer {{app_token}}

{
    "repoName": "aaa3",
    "mainBranch": "main",
    "username": "heykia3",
    "email": "heykia3@protonmail.com",
    "ownerType": "USER",
    "visibility": "PUBLIC",
    "readme": true,
    "message": "Initial Commit"
}

### 저장소 등록 without init commit
POST {{url}}/api/repositories
Authorization: Bearer {{app_token}}

{
   "repoName": "bbb",
    "mainBranch": "main",
    "username": "heykia3",
    "email": "heykia3@protonmail.com",
    "organizeId": 2,
    "visibility": "PUBLIC"
}

### 저장소목록 조회
GET {{url}}/api/repositories
Authorization: Bearer {{app_token}}

### 저장소 상세 조회
GET {{url}}/api/repositories/10
Authorization: Bearer {{app_token}}

### 저장소 삭제
DELETE {{url}}/api/repositories/6
Authorization: Bearer {{app_token2}}

#######################################################
### Branch ############################################
#######################################################

### 브랜치 목록 조회
GET {{url}}/api/repositories/10/branches
Authorization: Bearer {{app_token}}

### 브랜치 상세 조회
GET {{url}}/api/repositories/10/branches/main
Authorization: Bearer {{app_token}}

### 브랜치 등록
POST {{url}}/api/repositories/10/branches
Authorization: Bearer {{app_token}}

{
    "branchName": "develop",
    "sourceBranch": "main"
}

### 브랜치 삭제
DELETE {{url}}/api/repositories/10/branches/develop
Authorization: Bearer {{app_token}}



#######################################################
### Runner ############################################
#######################################################

### Runner 등록
POST {{url}}/runners
Authorization: Bearer {{app_token}}

{
  "scopeType": "GLOBAL",
  "description": "hihi"
}

### Repository 목록 조회
GET {{url}}/runners
Authorization: Bearer {{app_token}}

### Repository 상세 조회
GET {{url}}/runners/4
Authorization: Bearer {{app_token}}

### Repository 단건 삭제
DELETE {{url}}/runners/
Authorization: Bearer {{app_token}}


### Runner 활성화
POST {{url}}/runners/6/activate
Authorization: Bearer {{app_token}}
Accept: application/json
Content-Type: application/json

{
  "token": "RNR-85B46DCBB9BF4A4F896B3E3E"
}


### 내부 JWT로 보호된 API 테스트 (app_token 설정 후 사용)
GET {{url}}/api/organizes
Authorization: Bearer {{app_token}}


#######################################################
### Organize Members ##################################
#######################################################

### 조직 멤버 추가
POST {{url}}/api/organizes/1/members
Authorization: Bearer {{app_token}}

{
  "userId": 1,
  "role": "MEMBER"
}

### 조직 멤버 삭제
DELETE {{url}}/api/organizes/1/members/1
Authorization: Bearer {{app_token}}

### 조직 멤버 목록
GET {{url}}/api/organizes/1/members
Authorization: Bearer {{app_token}}

#######################################################
### Repository Members ################################
#######################################################

### 저장소 멤버 추가
POST {{url}}/api/repositories/1/members
Authorization: Bearer {{app_token}}

{
  "userId": 1,
  "role": "READER"
}

### 저장소 멤버 삭제
DELETE {{url}}/api/repositories/1/members/1
Authorization: Bearer {{app_token}}

### 저장소 멤버 목록
GET {{url}}/api/repositories/1/members
Authorization: Bearer {{app_token}}
